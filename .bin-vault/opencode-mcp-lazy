#!/usr/bin/env bash
# Launch mcp-lazy opencode variant in full isolation.
# Uses the feature/mcp-lazy-search binary with dedicated config/data dirs.
# Does NOT interfere with the real opencode instance (port 36963, ~/.config/opencode).

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
BIN="$SCRIPT_DIR/opencode-mcp-lazy-search"
CONFIG_DIR="$SCRIPT_DIR/mcp-lazy-config"
DATA_DIR="${XDG_DATA_HOME:-$HOME/.local/share}/opencode-mcp-lazy"
DB_FILE="$DATA_DIR/opencode.db"
PORT="${OPENCODE_MCP_LAZY_PORT:-37200}"

mkdir -p "$DATA_DIR"

export OPENCODE_CONFIG_DIR="$CONFIG_DIR"
export OPENCODE_DISABLE_PROJECT_CONFIG=false
export OPENCODE_DISABLE_AUTOUPDATE=1
export OPENCODE_SERVER_PASSWORD=""
export OPENCODE_DB="$DB_FILE"

# Ensure OPENCODE_EXPERIMENTAL is not set (prevents Immer freeze bug)
unset OPENCODE_EXPERIMENTAL 2>/dev/null || true

exec "$BIN" "$@"
